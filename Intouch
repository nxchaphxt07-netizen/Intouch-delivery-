export default function App() {
  // --- STATES ---
  const [selectedCategory, setSelectedCategory] = useState('recommended');
  const [searchQuery, setSearchQuery] = useState('');
  const [cart, setCart] = useState([]);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [activeModalItem, setActiveModalItem] = useState(null);
  const [orderType, setOrderType] = useState('delivery'); // 'delivery' | 'takeaway'
  const [customerInfo, setCustomerInfo] = useState({
    name: '',
    phone: '',
    address: '',
    note: ''
  });
  const [paymentMethod, setPaymentMethod] = useState('promptpay'); // 'promptpay' | 'cod'
  const [paymentSlip, setPaymentSlip] = useState(null);
  const [confirmedOrder, setConfirmedOrder] = useState(null);

  // --- ITEM CUSTOMIZATION MODAL STATE ---
  const [modalQuantity, setModalQuantity] = useState(1);
  const [selectedSpiciness, setSelectedSpiciness] = useState('');
  const [selectedToppings, setSelectedToppings] = useState([]);
  const [itemNote, setItemNote] = useState('');

  // --- FILTERED MENU ---
  const filteredMenu = useMemo(() => {
    return MENU_ITEMS.filter(item => {
      const matchesCategory = selectedCategory === 'all' || item.categoryId === selectedCategory;
      const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
                            item.description.toLowerCase().includes(searchQuery.toLowerCase());
      return matchesCategory && matchesSearch;
    });
  }, [selectedCategory, searchQuery]);

  // --- CART CALCULATIONS ---
  const subtotal = useMemo(() => {
    return cart.reduce((sum, item) => sum + (item.totalUnitPrice * item.quantity), 0);
  }, [cart]);

  const deliveryFee = orderType === 'delivery' ? (subtotal > 0 ? 30 : 0) : 0;
  const grandTotal = subtotal + deliveryFee;

  // --- HANDLERS ---
  const openCustomizationModal = (item) => {
    setActiveModalItem(item);
    setModalQuantity(1);
    setSelectedSpiciness(item.spicinessOptions.length > 0 ? item.spicinessOptions[1] || item.spicinessOptions[0] : '');
    setSelectedToppings([]);
    setItemNote('');
  };

  const handleToppingToggle = (topping) => {
    if (selectedToppings.some(t => t.id === topping.id)) {
      setSelectedToppings(selectedToppings.filter(t => t.id !== topping.id));
    } else {
      setSelectedToppings([...selectedToppings, topping]);
    }
  };

  const handleAddToCart = () => {
    if (!activeModalItem) return;

    const toppingExtraCost = selectedToppings.reduce((sum, t) => sum + t.price, 0);
    const totalUnitPrice = activeModalItem.price + toppingExtraCost;

    const cartItem = {
      cartItemId: Date.now() + Math.random().toString(),
      id: activeModalItem.id,
      name: activeModalItem.name,
      basePrice: activeModalItem.price,
      totalUnitPrice: totalUnitPrice,
      spiciness: selectedSpiciness,
      toppings: selectedToppings,
      note: itemNote,
      quantity: modalQuantity,
      image: activeModalItem.image
    };

    setCart(prev => [...prev, cartItem]);
    setActiveModalItem(null);
    setIsCartOpen(true);
  };

  const updateCartQuantity = (cartItemId, delta) => {
    setCart(prev => prev.map(item => {
      if (item.cartItemId === cartItemId) {
        const newQty = item.quantity + delta;
        return newQty > 0 ? { ...item, quantity: newQty } : null;
      }
      return item;
    }).filter(Boolean));
  };

  const handleSlipUpload = (e) => {
    const file = e.target.files[0];
    if (file) {
      setPaymentSlip(URL.createObjectURL(file));
    }
  };

  const generateLineMessage = (order) => {
    let msg = `🍣 *สั่งซื้อออเดอร์ใหม่ #${order.id}*\n`;
    msg += `--------------------------------\n`;
    msg += `👤 *ลูกค้า:* ${order.customer.name}\n`;
    msg += `📞 *เบอร์โทร:* ${order.customer.phone}\n`;
    msg += `📍 *รูปแบบ:* ${order.type === 'delivery' ? 'จัดส่งถึงบ้าน' : 'รับที่ร้าน (Takeaway)'}\n`;
    if (order.type === 'delivery') {
      msg += `🏠 *ที่อยู่:* ${order.customer.address}\n`;
    }
    msg += `--------------------------------\n`;
    msg += `📋 *รายการอาหาร:*\n`;
    order.items.forEach((item, index) => {
      msg += `${index + 1}. ${item.name} x${item.quantity} = ฿${item.totalUnitPrice * item.quantity}\n`;
      if (item.spiciness) msg += `   - ความเผ็ด: ${item.spiciness}\n`;
      if (item.toppings.length > 0) msg += `   - ท็อปปิ้ง: ${item.toppings.map(t => t.name).join(', ')}\n`;
      if (item.note) msg += `   - โน้ต: ${item.note}\n`;
    });
    msg += `--------------------------------\n`;
    msg += `💵 *ค่าอาหาร:* ฿${order.subtotal}\n`;
    msg += `🛵 *ค่าจัดส่ง:* ฿${order.deliveryFee}\n`;
    msg += `💰 *ราคารวมสุทธิ:* ฿${order.grandTotal}\n`;
    msg += `💳 *การชำระเงิน:* ${order.paymentMethod === 'promptpay' ? 'โอนผ่านสแกน QR Code (แนบสลิป)' : 'เก็บเงินปลายทาง (COD)'}\n`;
    if (order.customer.note) {
      msg += `📝 *หมายเหตุเพิ่มเติม:* ${order.customer.note}\n`;
    }
    return msg;
  };

  const handlePlaceOrder = () => {
    if (!customerInfo.name || !customerInfo.phone) {
      alert('กรุณากรอกชื่อและเบอร์โทรศัพท์สำหรับติดต่อ');
      return;
    }
    if (orderType === 'delivery' && !customerInfo.address) {
      alert('กรุณากรอกที่อยู่สำหรับจัดส่ง');
      return;
    }

    const orderData = {
      id: 'ORD-' + Math.floor(100000 + Math.random() * 900000),
      createdAt: new Date().toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' }),
      items: [...cart],
      subtotal,
      deliveryFee,
      grandTotal,
      type: orderType,
      customer: customerInfo,
      paymentMethod,
      paymentSlip,
      status: 'รอร้านค้ารับออเดอร์'
    };

    setConfirmedOrder(orderData);
    setCart([]);
    setIsCartOpen(false);
  };

  const sendToLineOA = () => {
    if (!confirmedOrder) return;
    const text = encodeURIComponent(generateLineMessage(confirmedOrder));
    // Simulated LINE OA link redirect (Users can adjust their LINE OA URL)
    window.open(`https://line.me/R/oaMessage/@delicious_food/?${text}`, '_blank');
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans pb-24 md:pb-8">
      
      {/* HEADER BAR */}
      <header className="sticky top-0 z-30 bg-white border-b border-slate-200 shadow-sm">
        <div className="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
          
          {/* Brand Logo & Name */}
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-2xl bg-gradient-to-tr from-orange-500 to-amber-400 flex items-center justify-center text-white shadow-md shadow-orange-500/20 font-bold text-xl">
              😋
            </div>
            <div>
              <h1 className="font-extrabold text-slate-900 text-lg leading-tight flex items-center gap-2">
                ครัวคุณติ๊ก เดลิเวอรี่
                <span className="text-[10px] bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full border border-emerald-200">
                  เปิดอยู่
                </span>
              </h1>
              <p className="text-xs text-slate-500 flex items-center gap-1">
                <Clock size={12} className="text-orange-500" /> จัดส่ง 25-35 นาที • สั่งง่ายผ่านเว็บ
              </p>
            </div>
          </div>

          {/* Cart Icon (Desktop View) */}
          <button 
            onClick={() => setIsCartOpen(true)}
            className="relative hidden md:flex items-center gap-2 bg-orange-500 hover:bg-orange-600 active:scale-95 text-white font-medium px-4 py-2 rounded-xl transition-all shadow-md shadow-orange-500/20"
          >
            <ShoppingBag size={18} />
            <span>ตะกร้าของฉัน</span>
            {cart.length > 0 && (
              <span className="bg-white text-orange-600 font-bold text-xs w-5 h-5 rounded-full flex items-center justify-center shadow-inner ml-1">
                {cart.reduce((a, b) => a + b.quantity, 0)}
              </span>
            )}
          </button>
        </div>

        {/* SEARCH BAR & QUICK FILTERS */}
        <div className="max-w-5xl mx-auto px-4 pb-3">
          <div className="relative">
            <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400" size={18} />
            <input 
              type="text" 
              placeholder="ค้นหาชื่อเมนู เช่น กะเพรา, ผัดไทย, ชาไทย..." 
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full bg-slate-100 border border-slate-200 rounded-xl pl-10 pr-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500/20 focus:border-orange-500 transition-all"
            />
            {searchQuery && (
              <button 
                onClick={() => setSearchQuery('')}
                className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600"
              >
                <X size={16} />
              </button>
            )}
          </div>
        </div>
      </header>

      {/* CATEGORY BAR */}
      <nav className="sticky top-[113px] z-20 bg-white/95 backdrop-blur-md border-b border-slate-200 py-2.5 px-4 shadow-xs">
        <div className="max-w-5xl mx-auto flex gap-2 overflow-x-auto no-scrollbar scroll-smooth">
          {MENU_CATEGORIES.map(cat => {
            const Icon = cat.icon;
            const isActive = selectedCategory === cat.id;
            return (
              <button
                key={cat.id}
                onClick={() => setSelectedCategory(cat.id)}
                className={`whitespace-nowrap flex items-center gap-2 px-4 py-2 rounded-full text-sm font-semibold transition-all shrink-0 ${
                  isActive 
                    ? 'bg-orange-500 text-white shadow-md shadow-orange-500/20' 
                    : 'bg-slate-100 text-slate-600 hover:bg-slate-200/80'
                }`}
              >
                <Icon size={16} />
                {cat.name}
              </button>
            );
          })}
        </div>
      </nav>

      {/* MAIN CONTAINER */}
      <main className="max-w-5xl mx-auto px-4 py-6">
        
        {/* PROMOTION BANNER */}
        <div className="mb-6 rounded-2xl bg-gradient-to-r from-orange-500 via-amber-500 to-orange-600 p-4 sm:p-6 text-white shadow-lg shadow-orange-500/15 relative overflow-hidden flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
          <div className="relative z-10">
            <span className="bg-white/20 text-white text-xs font-semibold px-2.5 py-1 rounded-md backdrop-blur-sm">
              โปรโมชั่นเปิดตัวเว็บสั่งอาหาร 🚀
            </span>
            <h2 className="text-xl sm:text-2xl font-black mt-2">สั่งผ่านเว็บวันนี้ ค่าส่งเพียง 30 บาท!</h2>
            <p className="text-orange-100 text-xs sm:text-sm mt-1">ไม่ต้องรอแอดมินตอบไลน์ เลือกเมนู ปรับแต่งตามใจ แล้วส่งออเดอร์ได้ทันที</p>
          </div>
          <div className="bg-white/10 backdrop-blur-md p-3 rounded-xl border border-white/20 text-center w-full sm:w-auto shrink-0">
            <span className="text-xs text-orange-100 block">รองรับการชำระเงิน</span>
            <div className="font-bold text-sm text-white flex items-center justify-center gap-2 mt-0.5">
              <span>พร้อมเพย์ QR</span> • <span>ปลายทาง</span>
            </div>
          </div>
        </div>

        {/* SECTION TITLE */}
        <div className="flex items-center justify-between mb-4">
          <h2 className="font-bold text-lg text-slate-900 flex items-center gap-2">
            {MENU_CATEGORIES.find(c => c.id === selectedCategory)?.name || 'รายการอาหาร'}
            <span className="text-xs font-normal text-slate-500">({filteredMenu.length} รายการ)</span>
          </h2>
        </div>

        {/* MENU GRID */}
        {filteredMenu.length > 0 ? (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {filteredMenu.map(item => (
              <div 
                key={item.id}
                className="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm hover:shadow-md transition-all flex flex-col justify-between group"
              >
                <div>
                  <div className="relative h-44 w-full overflow-hidden bg-slate-100">
                    <img 
                      src={item.image} 
                      alt={item.name} 
                      className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                    <div className="absolute top-2 right-2 bg-black/60 backdrop-blur-md text-white px-2.5 py-1 rounded-full text-xs font-medium flex items-center gap-1">
                      ⭐ {item.rating} ({item.reviews})
                    </div>
                  </div>

                  <div className="p-4">
                    <h3 className="font-bold text-slate-900 text-base leading-snug group-hover:text-orange-600 transition-colors">
                      {item.name}
                    </h3>
                    <p className="text-slate-500 text-xs mt-1 line-clamp-2 leading-relaxed">
                      {item.description}
                    </p>
                  </div>
                </div>

                <div className="px-4 pb-4 pt-0 flex items-center justify-between mt-auto">
                  <div>
                    <span className="text-xs text-slate-400 block">ราคา</span>
                    <span className="font-extrabold text-lg text-orange-600">฿{item.price}</span>
                  </div>
                  <button 
                    onClick={() => openCustomizationModal(item)}
                    className="bg-orange-50 hover:bg-orange-500 text-orange-600 hover:text-white border border-orange-200 hover:border-orange-500 px-3.5 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-xs active:scale-95"
                  >
                    <Plus size={16} />
                    <span>เลือกตัวเลือก</span>
                  </button>
                </div>
              </div>
            ))}
          </div>
