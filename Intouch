                <span>{confirmedOrder.customer.phone}</span>
              </div>
              <div className="text-slate-500">
                รายการอาหาร: {confirmedOrder.items.length} รายการ (รวม ฿{confirmedOrder.grandTotal})
              </div>
              <div className="text-slate-500">
                การชำระเงิน: {confirmedOrder.paymentMethod === 'promptpay' ? 'พร้อมเพย์ QR' : 'เก็บเงินปลายทาง'}
              </div>
            </div>

            {/* Close Button */}
            <button 
              onClick={() => setConfirmedOrder(null)}
              className="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-2.5 rounded-xl text-xs transition-all"
            >
              กลับสู่หน้าหลัก
            </button>

          </div>
        </div>
      )}

    </div>
  );
}
